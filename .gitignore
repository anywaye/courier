# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
courier-*.tar

# Local environment overrides. In production SECRET_KEY_BASE and DATABASE_URL
# come from the environment and config/runtime.exs raises without them, so
# nothing holding a real value belongs in this repository.
.env
.env.*
!.env.example

# Kamal's secrets, and ONLY that.
#
# `config/deploy.yml` names a dozen credentials — DATABASE_URL,
# COURIER_SECRET_BOX_KEY, RESTIC_PASSWORD, the R2 pair — and `kamal init` writes
# their VALUES into `.kamal/secrets` on the operator's machine. Every name in
# that directory is a credential, and `RESTIC_PASSWORD` is the one value that
# makes the entire backup repository readable or not, so an unignored `.kamal/`
# is a `git add -A` away from publishing the key that opens every snapshot.
#
# The trailing slash matters in the other direction: `.kamal/hooks/` is where a
# Kamal 2 pre-deploy hook lives, and a hook is a committed script rather than a
# secret. Ignoring the directory wholesale would make that file invisible to
# `git add`, so the ignore is narrowed to the two files Kamal actually writes.
.kamal/secrets
.kamal/secrets-*

# ElixirLS build artifacts.
.elixir_ls

# `caf dev` GENERATES this from cafaye.yml and rewrites it on every run — the
# file says so in its own first line ("Do not edit: every run rewrites this
# file"). It is build output shaped like a source file, which is why it needs
# saying here rather than relying on it being untracked by accident: an
# untracked generated file is one `git add -A` away from being committed, and
# from there it is a merge conflict nobody can resolve by reading it.
#
# The tracked `docker-compose.yml` is the opposite case and is NOT ignored. That
# one is hand-written, it is courier's own override on kit's shared stack, and it
# is reviewed.
/cafe.dev.compose.yaml


# The `cf` CLI's local cache, discovered committed by accident: a `git add -A`
# swept `.cloudflare/cache/cloudflare-account.json` in, and the file is the
# tool's own state directory — the account id it resolved on THIS machine, held
# so the next command need not ask. Nothing in the repository reads it, every
# developer's `cf` run writes it, and it is the "build output shaped like a
# source file" case above with a credential-adjacent file: an account id is not
# a secret, but the cache is not ours to publish either.
/.cloudflare/
keyring/
secrets/
