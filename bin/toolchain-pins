#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: bin/toolchain-pins [--check <workflow-file>]" >&2
  exit 2
}

pin() {
  awk -v key="$1" '
    match($0, "^[[:space:]]*\"?" key "\"?[[:space:]]*=[[:space:]]*\"[^\"]*\"") {
      s = substr($0, RSTART, RLENGTH)
      sub(/^[^=]*=[[:space:]]*"/, "", s)
      sub(/"$/, "", s)
      print s
      exit
    }
  ' mise.toml
}

elixir_pin="$(pin elixir)"
erlang_pin="$(pin erlang)"

if [ -z "$elixir_pin" ] || [ -z "$erlang_pin" ]; then
  echo "toolchain-pins: mise.toml has no elixir/erlang pin under [tools]" >&2
  echo "  read elixir='${elixir_pin}' erlang='${erlang_pin}'" >&2
  exit 1
fi

check() {
  file="$1"
  if [ ! -f "$file" ]; then
    echo "toolchain-pins: no such file: $file" >&2
    exit 1
  fi
  in_workflow="$(
    grep -E '^ *versions:' "$file" |
      sed -n 's/.*"elixir":"\([^"]*\)".*"erlang":"\([^"]*\)".*/\1 \2/p'
  )"
  if [ -z "$in_workflow" ]; then
    echo "toolchain-pins: no versions: input in $file" >&2
    echo "  expected: versions: '{\"elixir\":\"$elixir_pin\",\"erlang\":\"$erlang_pin\"}'" >&2
    exit 1
  fi
  if [ "$in_workflow" != "$elixir_pin $erlang_pin" ]; then
    echo "toolchain-pins: $file pins '$in_workflow'" >&2
    echo "toolchain-pins: mise.toml pins '$elixir_pin $erlang_pin'" >&2
    echo "  one of the two is now a lie about which runtime CI builds with" >&2
    exit 1
  fi
  echo "toolchain-pins: $file and mise.toml agree — elixir $elixir_pin, erlang $erlang_pin"
}

if [ "$#" -eq 0 ]; then
  echo "elixir=$elixir_pin"
  echo "erlang=$erlang_pin"
  if [ -n "${GITHUB_OUTPUT:-}" ]; then
    {
      echo "elixir=$elixir_pin"
      echo "erlang=$erlang_pin"
    } >> "$GITHUB_OUTPUT"
  fi
elif [ "$#" -eq 2 ] && [ "$1" = "--check" ]; then
  check "$2"
else
  usage
fi
