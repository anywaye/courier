#!/usr/bin/env bash

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo="$(cd "$here/.." && pwd)"

core="${ANYWAYE_CORE:-}"
if [ -z "$core" ]; then
  for candidate in "$repo/../core" "$repo/../../anywaye/core" "$HOME/Code/any/anywaye/core"; do
    if [ -x "$candidate/harness/bin/gate-check" ]; then
      core="$(cd "$candidate" && pwd)"
      break
    fi
  done
fi
if [ -z "$core" ] || [ ! -x "$core/harness/bin/gate-check" ]; then
  echo "gate-self-test: no anywaye/core checkout found, so the declaration cannot be checked." >&2
  echo "  Set ANYWAYE_CORE to a core checkout (it must have harness/bin/gate-check)," >&2
  echo "  or leave a sibling directory named 'core' next to this repository." >&2
  echo "  This is exit 2 and never 0: a check that could not run has not checked." >&2
  exit 2
fi
gatecheck="$core/harness/bin/gate-check"

work="$(mktemp -d "${TMPDIR:-/tmp}/courier-gate-self-test.XXXXXX")"
trap 'rm -rf "$work"' EXIT

passed=0
failed=0
skipped=0
declare -a failures=()

make_copy() {
  local dest="$1"
  mkdir -p "$dest"
  (cd "$repo" && git ls-files -z | xargs -0 tar cf -) | (cd "$dest" && tar xf -)
  cp "$repo/gate.yml" "$dest/gate.yml"
  [ -d "$repo/deps" ] && ln -s "$repo/deps" "$dest/deps"
  [ -d "$repo/_build" ] && ln -s "$repo/_build" "$dest/_build"
  return 0
}

swap() {
  python3 - "$1" "$2" "$3" <<'PY'
import sys
path, old, new = sys.argv[1], sys.argv[2], sys.argv[3]
text = open(path, encoding="utf-8").read()
if text.count(old) != 1:
    raise SystemExit(
        f"gate-self-test: {path}: expected exactly one occurrence of {old!r}, "
        f"found {text.count(old)}. A stale recipe must not silently pass."
    )
open(path, "w", encoding="utf-8").write(text.replace(old, new))
PY
}

stub_gate() {
  cat > "$1/bin/prime" <<EOF
#!/bin/sh
printf '%s\\n' '$2'
EOF
  chmod +x "$1/bin/prime"
}

check() {
  local dest="$1" label="$2"
  shift 2
  report="$work/$label.txt"
  set +e
  "$gatecheck" "$@" --log-dir "$work/logs-$label" "$dest" > "$report" 2>&1
  status=$?
  set -e
}

expect_red() {
  local label="$1" want="$2"
  if [ "$status" -eq 0 ]; then
    printf 'FAIL %-28s the checker stayed GREEN (exit 0) on a deliberate breakage\n' "$label"
    failed=$((failed + 1)); failures+=("$label: green on a red case"); return 1
  fi
  if ! grep -q "^FAIL gate\.$want:" "$report"; then
    printf 'FAIL %-28s went red, but not from %s. It reported:\n' "$label" "gate.$want"
    sed -n 's/^FAIL \(gate\.[a-z-]*\):.*/    \1/p' "$report" | sort -u | sed 's/^/      /'
    failed=$((failed + 1)); failures+=("$label: red, but not from gate.$want"); return 1
  fi
  printf 'ok   %-28s caught by gate.%s (checker exit %s)\n' "$label" "$want" "$status"
  passed=$((passed + 1)); return 0
}

expect_green() {
  local label="$1"
  if [ "$status" -ne 0 ]; then
    printf 'FAIL %-28s the UNMODIFIED declaration is not green (exit %s)\n' "$label" "$status"
    sed -n 's/^\(FAIL\|COULD NOT RUN\) /\1 /p' "$report" | sed 's/^/      /'
    failed=$((failed + 1)); failures+=("$label: unmodified declaration is not green"); return 1
  fi
  local warns
  warns="$(grep -c '^WARN gate\.' "$report" || true)"
  printf 'ok   %-28s green (exit 0), %s warning(s) reported and not counted as passes\n' \
    "$label" "$warns"
  passed=$((passed + 1)); return 0
}

echo "gate-self-test: courier's gate declaration, proved able to fail"
echo "  repository:  $repo"
echo "  declaration: gate.yml"
echo "  checker:     ${gatecheck#"$core"/}  (core at $core)"
echo

dirty="$(git -C "$repo" status --porcelain | grep -v '^?? ' || true)"
if [ -n "$dirty" ]; then
  printf 'warn the worktree has MODIFIED TRACKED files; the copy takes committed\n'
  printf 'warn state from git ls-files, so the control runs against a different\n'
  printf 'warn tree than the one you are reading. Staged or committed, re-run.\n'
  printf '%s\n' "$dirty" | sed 's/^/warn   /'
  printf '\n'
fi

untracked="$(git -C "$repo" status --porcelain | grep '^?? ' || true)"
if [ -n "$untracked" ]; then
  printf 'warn UNTRACKED files below are NOT in the copy, and the control runs the\n'
  printf 'warn real gate in it. If it fails with a missing module, this is why:\n'
  printf '%s\n' "$untracked" | sed 's/^/warn   /'
  printf 'warn stage or commit them (git add -A) and re-run.\n\n'
fi

echo "== the control: the unmodified declaration =="

ctl_static="$work/control"
make_copy "$ctl_static"
check "$ctl_static" control-static
expect_green "static (declaration vs tree)"

static_only="${GATE_SELF_TEST_STATIC_ONLY:-0}"
if [ "$static_only" = "1" ]; then
  skipped=$((skipped + 1))
  printf 'SKIP %-28s --prove needs the real 535-test suite; GATE_SELF_TEST_STATIC_ONLY=1\n' \
    "prove (runs the real gate)"
else
  check "$ctl_static" control-prove --prove
  expect_green "prove (runs the real gate)"
  if [ -f "$work/logs-control-prove/gate.log" ]; then
    printf '     the gate reported: %s\n' \
      "$(grep -E '^Result: ' "$work/logs-control-prove/gate.log" | tail -1)"
  fi
fi
echo

echo "== the breakages: one edit each, in a throwaway copy =="

d="$work/b1"; make_copy "$d"
swap "$d/gate.yml" "  entrypoint: bin/prime" "  entrypoint: bin/not-there"
check "$d" b1-entrypoint
expect_red "entrypoint missing" "entrypoint-missing"

d="$work/b2"; make_copy "$d"
printf '\n[tasks.other]\ndescription = "A second gate, which is the defect"\nrun = "./bin/assert-suite"\n' >> "$d/mise.toml"
swap "$d/gate.yml" "  miseTask: prime" "  miseTask: other"
check "$d" b2-misetask
expect_red "mise task elsewhere" "task-unresolvable"

d="$work/b3"; make_copy "$d"
swap "$d/gate.yml" "      match: '^Result: ([0-9]+) passed(?: \\([^)]*\\))?$'" "      match: '^no such summary line: ([0-9]+)$'"
stub_gate "$d" "Result: 535 passed"
check "$d" b3-proof-regex --prove
expect_red "proof regex matches none" "proof-missing"

d="$work/b4"; make_copy "$d"
swap "$d/gate.yml" "  workflow: ci/ci.yml" "  workflow: .github/workflows/nope.yml"
check "$d" b4-ci-missing
expect_red "ci workflow absent" "ci-missing"

d="$work/b5"; make_copy "$d"
cat > "$d/ci/decoy.yml" <<'YAML'
name: decoy
on: [push]
jobs:
  docs:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - name: build the docs
        run: mix docs
YAML
swap "$d/gate.yml" "  workflow: ci/ci.yml" "  workflow: .github/workflows/decoy.yml"
check "$d" b5-ci-disagrees
expect_red "ci never runs the gate" "ci-disagrees"

d="$work/b6"; make_copy "$d"
stub_gate "$d" "Result: 534/535 passed"
check "$d" b6-exits-zero --prove
expect_red "gate exits 0, ran none" "proof-missing"

d="$work/b7"; make_copy "$d"
swap "$d/gate.yml" "  selfContained: false" "  selfContained: true"
check "$d" b7-selfcontained
expect_red "self-contained overclaim" "schema"

d="$work/b8"; make_copy "$d"
swap "$d/gate.yml" "        command: [mix, deps.get]" "        command: [bin/setup, --now]"
check "$d" b8-requirement
expect_red "requirement path absent" "requirement-path-missing"

d="$work/b9"; make_copy "$d"
swap "$d/gate.yml" "  command: [mise, run, prime]" "  command: [bin/not-the-gate]"
check "$d" b9-command
expect_red "command absent" "command-missing"

echo
if [ "$skipped" -ne 0 ]; then
  printf 'SKIPPED %d check(s). A skipped check is not a passing check.\n' "$skipped"
fi
printf 'gate-self-test: %d passed, %d failed' "$passed" "$failed"
if [ "$skipped" -ne 0 ]; then
  printf ', %d skipped' "$skipped"
fi
printf '\n'
if [ "$failed" -ne 0 ]; then
  for f in "${failures[@]}"; do printf '  failed: %s\n' "$f"; done
  exit 1
fi
exit 0
